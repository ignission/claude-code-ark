{
  "name": "claude-code-ark",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "dev": "pnpm --filter @ark/web dev",
    "dev:server": "pnpm --filter @ark/server dev",
    "dev:full": "concurrently \"pnpm dev\" \"pnpm dev:server\"",
    "dev:remote": "pnpm --filter @ark/server dev:remote",
    "dev:quick": "pnpm --filter @ark/server dev:quick",
    "dev:full:remote": "concurrently \"pnpm dev\" \"pnpm dev:remote\"",
    "build": "pnpm -r build",
    "start": "pnpm --filter @ark/server start",
    "start:remote": "pnpm --filter @ark/server start:remote",
    "start:quick": "pnpm --filter @ark/server start:quick",
    "preview": "pnpm --filter @ark/web preview",
    "test:e2e": "playwright test",
    "check": "biome check . && tsc -b",
    "format": "biome check --write .",
    "lint": "biome lint ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.7.0",
    "concurrently": "^9.2.1",
    "pnpm": "^10.15.1",
    "typescript": "6.0.3",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "pnpm": {
    "patchedDependencies": {
      "wouter@3.7.1": "patches/wouter@3.7.1.patch"
    },
    "overrides": {
      "tailwindcss>nanoid": "5.1.7"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "@tailwindcss/oxide"
    ]
  }
}
