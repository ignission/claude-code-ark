{
  "name": "claude-code-ark",
  "version": "1.4.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @ark/web dev",
    "dev:server": "tsx watch packages/server/src/cli.ts",
    "dev:full": "concurrently \"pnpm dev\" \"pnpm dev:server\"",
    "dev:remote": "tsx watch packages/server/src/cli.ts --remote",
    "dev:quick": "tsx watch packages/server/src/cli.ts --quick",
    "dev:full:remote": "concurrently \"pnpm dev\" \"pnpm dev:remote\"",
    "build": "pnpm -r build",
    "start": "NODE_ENV=production node packages/server/dist/cli.js",
    "start:remote": "NODE_ENV=production node packages/server/dist/cli.js --remote",
    "start:quick": "NODE_ENV=production node packages/server/dist/cli.js --quick",
    "preview": "pnpm --filter @ark/web preview",
    "test:e2e": "playwright test",
    "check": "biome check . && tsc -b",
    "test": "vitest run && pnpm test:harness",
    "test:harness": "/bin/bash .claude/hooks/tests/test-bash-guard.sh",
    "format": "biome check --write .",
    "lint": "biome lint ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "concurrently": "^10.0.5",
    "pnpm": "11.24.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
