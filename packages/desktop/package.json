{
  "name": "@ark/desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc -b",
    "dev": "concurrently -k -n vite,electron -c \"cyan,magenta\" \"pnpm --filter @ark/web dev\" \"wait-on http://localhost:4000 && pnpm dev:electron\"",
    "dev:electron": "pnpm build && ARK_DEV=1 electron dist/main.js",
    "package:dir": "electron-builder --dir",
    "package:mac": "electron-builder --mac --arm64"
  },
  "dependencies": {
    "@ark/server": "workspace:*",
    "@ark/shared": "workspace:*"
  },
  "devDependencies": {
    "@ark/web": "workspace:*",
    "concurrently": "^9.2.1",
    "electron": "^33.4.7",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.1",
    "typescript": "6.0.3",
    "wait-on": "^8.0.1"
  }
}
