{
  "name": "@ark/server",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist-types/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "dev:remote": "tsx watch src/cli.ts --remote",
    "dev:quick": "tsx watch src/cli.ts --quick",
    "build": "node build.mjs",
    "start": "NODE_ENV=production node dist/cli.js",
    "start:remote": "NODE_ENV=production node dist/cli.js --remote",
    "start:quick": "NODE_ENV=production node dist/cli.js --quick",
    "check": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.261",
    "@ark/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "http-proxy": "^1.18.1",
    "nanoid": "^6.0.1",
    "playwright-core": "^1.62.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "5.0.6",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^26.4.0",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.12",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
